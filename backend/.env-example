# Copy this file to .env and fill in the values

# Server
# HOST, PORT and PROTOCOL also build the Stripe success/cancel URLs,
# so they must be reachable from the user's browser
PORT=3000
HOST=localhost
PROTOCOL=http
# Where Stripe payment redirects send the user back to
FRONTEND_URL=http://localhost:5173

# MySQL (schema and seed data in backend/data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tienda_libros

# Secret used to sign and verify JWT tokens
JWT_SECRET=

# Stripe secret key (use a test key: sk_test_...)
STRIPE_SECRET=
